        theme: (
            background: "#0b0e14",
            text: "#e6edf3",
            hint: "#8b98a5",
            accent: "#4fd6be",
            accent_text: "#04211c",
            font_family: "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        ),
        wallpaper: (
            fit: Tile,
            scale: 1,
            crisp: true,
        ),
    ),
)
