(
    app_name: "Mandelbrot",
    publisher: "@73v3",
    description: "The Mandelbrot set, explored live at 120 Hz — drag and dive to a magnification of 10^260, every pixel exact or proven.",
    version: "1.0.0",
    copyright: "© 2026 73v3 - 73v3.com",
    publish_enabled: true,
    web_splash: (
        start_label: "Click to explore",
